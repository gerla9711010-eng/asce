# 複製成 .env 並填入實際值（.env 不會 commit 進 git）

# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATA_SOURCE_ID=bcf8f493-4aac-45bf-8223-9b49f29aff63

# publish.py（上架）用 profile/ session，不需要帳密；grab.py（搶單）改用 API 登入，要帳密：
KEIS_USERNAME=你的KEIS帳號
KEIS_PASSWORD=你的KEIS密碼

# 公買搶單 grab.py 用：搶到後推 LINE 的 n8n webhook（可選，不填就只存 grabbed.csv）
KEIS_NOTIFY_WEBHOOK=https://primary-production-68428.up.railway.app/webhook/keis-grab

# 搶到後同步寫進 Notion「KEIS 搶單名單」資料庫（可選，兩個都填才會啟用）
# KEIS_NOTION_TOKEN 沒設會自動沿用上面的 NOTION_TOKEN；把該 integration 分享給這個資料庫即可
KEIS_NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KEIS_NOTION_DB_ID=4f28b91531594c618725afc3ecc36e2f

# 心跳（可選）：watch 每 10 分鐘打一下，n8n 排程檢查超過 2 小時沒心跳推 LINE 告警
KEIS_HEARTBEAT_WEBHOOK=https://primary-production-68428.up.railway.app/webhook/keis-heartbeat

# 外部看門人（可選，2026-08-01 加）：心跳連續失敗超過 2 小時（排除每晚斷網窗口）時，
# 繞過 n8n 直接打 LINE Messaging API 告警——防的是「n8n 自己掛了」這種上面那條鏈路
# 也一起死掉的情況。去 LINE Developers Console 複製本來那個 Bot 的 Channel Access Token
# （跟 n8n 用的是同一個 Bot，但 token 要另外拿，n8n API 不會吐明文）。不填就沒有這條防線。
KEIS_LINE_DIRECT_TOKEN=
# KEIS_LINE_PUSH_USERID=Ufab42c56b2eb9b9a9ff18c367b85a6dd   # 預設薛力瑜本人，通常不用改
