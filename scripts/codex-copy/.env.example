# 複製成 .env 再填。.env 不會進 git。
# n8n 呼叫時要帶的密鑰（自己隨便設一串長的）。一定要設——這個網址對外開放，
# 沒密鑰任何人打得到就能燒掉你的 ChatGPT 訂閱額度。
CODEX_COPY_TOKEN=

# 可選：codex 逾時或吐不出 JSON 時的退路。不填就是少一層保險，不影響正常運作。
# 跟 n8n「Gemini API Key」憑證同一把。
GEMINI_API_KEY=

# n8n credential「Codex 文案通道 Token」的 id。由 rotate_token.py 建立並填入，
# server.py 開通道時用它掛上節點（token 值只存在這份 .env 和 n8n 裡，不會進 git）。
CODEX_N8N_CRED_ID=
