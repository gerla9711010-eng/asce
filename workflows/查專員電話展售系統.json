      "parameters": {
        "jsCode": "// 從登入頁撈 ASP.NET 的三個 hidden 欄位 + 第一段 cookie\nconst r = $input.first().json || {};\nconst html = String(r.body || r.data || '');\nconst pick = (n) => {\n  const m = html.match(new RegExp('id=\"' + n + '\"[^>]*value=\"([^\"]*)\"'));\n  return m ? m[1] : '';\n};\nconst raw = (r.headers || {})['set-cookie'] || (r.headers || {})['Set-Cookie'] || [];\nconst cookie = (Array.isArray(raw) ? raw : [raw])\n  .map(c => String(c).split(';')[0]).filter(Boolean).join('; ');\nreturn [{ json: {\n  viewstate: pick('__VIEWSTATE'),\n  gen: pick('__VIEWSTATEGENERATOR'),\n  ev: pick('__EVENTVALIDATION'),\n  cookie,\n  ok: pick('__VIEWSTATE') !== '',\n} }];"
      },
      "alwaysOutputData": true
    },
