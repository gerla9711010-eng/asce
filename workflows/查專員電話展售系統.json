    {
      "id": "es-04",
      "name": "組查詢 cookie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "// 登入後把新舊 cookie 併起來給查詢用\nconst r = $input.first().json || {};\nconst raw = (r.headers || {})['set-cookie'] || (r.headers || {})['Set-Cookie'] || [];\nconst fresh = (Array.isArray(raw) ? raw : [raw])\n  .map(c => String(c).split(';')[0]).filter(Boolean);\nconst old = String($('組登入參數').first().json.cookie || '')\n  .split('; ').filter(Boolean);\nconst seen = new Set();\nconst all = [...fresh, ...old].filter(c => {\n  const k = c.split('=')[0];\n  if (seen.has(k)) return false;\n  seen.add(k); return true;\n});\nreturn [{ json: { cookie: all.join('; ') } }];"
      },
      "alwaysOutputData": true
    },
