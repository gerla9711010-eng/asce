    {
      "id": "es-06",
      "name": "解析專員電話",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "// 解析「詳細聯絡資訊」彈窗。查不到一律回空字串，絕不 throw。\nconst src = $('輸入').first().json || {};\nlet phone = '', from = '查不到';\ntry {\n  const html = String(($input.first().json || {}).body || '');\n  const text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n\n  // 「經紀人 經紀人 吳冠圻 / 0978329823」、空的長「經紀人2 經紀人2 / 」\n  const agents = [];\n  for (const m of text.matchAll(/經紀人(\\d*)\\s+經紀人\\1\\s*([^\\/\\s]*)\\s*\\/\\s*([0-9\\-]*)/g)) {\n    const name = (m[2] || '').trim();\n    const tel = (m[3] || '').trim();\n    if (name) agents.push({ name, tel });\n  }\n  const store = text.match(/分店\\s+分店\\s*([^\\/\\s]*)\\s*\\/\\s*([0-9\\-]+)/);\n\n  const want = String(src['專員'] || '').trim();\n  const hit = agents.find(a => a.name === want && a.tel);\n  if (hit) { phone = hit.tel; from = '本人手機'; }\n  else {\n    const any = agents.find(a => a.tel);\n    if (want && any) { phone = any.tel; from = '同案經紀人 ' + any.name; }\n    else if (any) { phone = any.tel; from = '經紀人 ' + any.name; }\n  }\n  // 有些經紀人沒留手機（例：詹屏），退回分店電話\n  if (!phone && store && store[2]) { phone = store[2]; from = '分店 ' + (store[1] || ''); }\n} catch (e) {\n  from = '解析失敗：' + e.message;\n}\nreturn [{ json: { ...src, '專員電話': phone, '電話來源': from } }];"
      },
      "alwaysOutputData": true
    }
  ],
