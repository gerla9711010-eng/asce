      "parameters": {
        "jsCode": "// 吐出最後一次上傳的頁面；還沒上傳過就給一行提示\nconst s = $getWorkflowStaticData('global');\nreturn [{ json: { html: s.html || '<meta charset=utf-8><p>還沒上傳過，先在電腦跑一次買方配案更新。</p>' } }];\n"
      },
