          "id": "M3yf42rgV4EM4hYw",
          "name": "買方配案頁 帳密"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 收 worker.py 上傳的整頁 HTML，存進 staticData（n8n_sync 不會把 staticData 拉進 git，客戶姓名不會進公開 repo）\nconst b = $input.first().json.body || {};\nif (typeof b.html !== 'string' || b.html.length < 100) throw new Error('沒收到 html');\nconst s = $getWorkflowStaticData('global');\ns.html = b.html; s.updatedAt = new Date().toISOString();\nreturn [{ json: { ok: true, bytes: b.html.length, updatedAt: s.updatedAt } }];\n"
      },
      "id": "1eb52dac-10cb-47c7-b382-9fe57b559623",
      "name": "存頁面",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "Cache-Control",
                "value": "no-store"
              },
              {
                "name": "X-Robots-Tag",
                "value": "noindex, nofollow"
              }
            ]
          }
        }
      },
      "id": "f063089e-6290-4c86-9fa9-dc5584970d11",
      "name": "回上傳結果",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
